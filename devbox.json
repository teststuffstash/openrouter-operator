{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "python@3.11",
    "uv@latest",
    "gitleaks@latest",
    "kubernetes-helm@latest",
    "gh@latest"
  ],
  "shell": {
    "init_hook": [],
    "scripts": {
      "ci": ["bash scripts/ci.sh"],
      "scan-secrets": ["gitleaks detect --source . --no-banner --verbose"],
      "package-chart": ["bash scripts/package-chart.sh"],
      "lint-chart": ["helm lint chart/ && helm template chart/ >/dev/null"]
    }
  }
}
